# Python
__pycache__/
*.py[cod]
*.egg-info/

# Personal context + reference papers
CLAUDE.md
papers/
papers.md

# SLURM job logs (regenerable artifacts; scp'd locally only for plotting)
logs/

# Model checkpoints — large, generated on the cluster, never committed (a stray
# `git add -A` on the cluster would otherwise try to stage ~260 GB).
experiments/

# LoRA-locality experiment outputs — generated on the cluster, synced via rsync
# (like results/), so cluster and laptop never fight over the same JSON.
studies/lora_locality/out/

# Study result JSONs — written by cluster RUNS, brought to the laptop via rsync only
# (NOT git). Keeping them out of git stops `git pull` on the cluster from reverting or
# deleting freshly-written results (which kept wiping run outputs). Plot LOCALLY from
# the rsync'd copies. Figures stay tracked (they're generated on the laptop, not the
# cluster, so runs never clobber them).
studies/*/results/

# Multilingual TOFU dataset (36 MB, cloned by setup.sh from
# alirezafarashah/multilingual_unlearning) — downloaded, not committed (§8).
data/raw/multilingual_unlearning/

# Python virtualenvs + caches — runtime, rebuildable (setup.sh / setup_grpo.sh).
# NEVER commit and NEVER let `git clean` touch these (they are gigabytes and slow
# to rebuild). Listed here so `git clean -fd` skips them.
.venv/
.venv-grpo/
.cache/
.tmp/

# OS / editor
.DS_Store
.idea/
.vscode/
# FLORES-200 parallel corpus (downloaded for Phase 1 vocab-overlap; official tarball).
data/raw/flores/
.venv-plot/
data/raw/tofu/
